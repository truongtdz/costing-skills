+     * @param endTime       thời điểm đóng
+     * @param waiting       trạng thái chờ
+     * @param inProgress    trạng thái đang xử lý
+     * @param failStatus    trạng thái lỗi của TaskLogDetail
+     * @param batchTotal    tổng số lô ebinventory đã gửi
