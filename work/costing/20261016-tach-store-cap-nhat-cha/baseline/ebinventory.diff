+     * Chia kết quả thành lô sao cho mọi dòng cùng chứng từ cha (ReferenceID của dòng sổ kho) nằm chung một lô.
+     * ebqueue ghi các lô song song và store cộng lại tổng tiền header bằng SUM trên chi tiết, nên hai lô cùng
+     * chạm một chứng từ là tranh khoá, deadlock. Chứng từ có nhiều dòng hơn cỡ lô thì lô chứa nó được vượt cỡ,
+     * không cắt. Dòng không có ReferenceID được coi là một chứng từ riêng.
+     *
+     * @param results   danh sách kết quả, thứ tự các dòng cùng chứng từ có thể nằm rải rác
+     * @param batchSize số dòng tối đa của một lô, trừ lô chứa chứng từ lớn hơn cỡ lô
+     * @return danh sách lô theo thứ tự chứng từ xuất hiện lần đầu; rỗng nếu không có kết quả
+     */
+    private List<List<CostingResult>> splitByParentDocument(List<CostingResult> results, int batchSize) {
+        // Kết quả ra theo nhóm VTHH nên dòng của một chứng từ nằm rải rác, gom lại theo ReferenceID trước
+        Map<String, List<CostingResult>> documents = new LinkedHashMap<>();
+        List<List<CostingResult>> groups = new ArrayList<>();
+        for (CostingResult result : results) {
+            if (result.referenceID() == null) {
+                groups.add(List.of(result));
+                continue;
+            }
+            List<CostingResult> document = documents.get(result.referenceID());
+            if (document == null) {
+                document = new ArrayList<>();
+                documents.put(result.referenceID(), document);
+                groups.add(document);
+            }
+            document.add(result);
+        }
+
+        List<List<CostingResult>> batches = new ArrayList<>();
+        List<CostingResult> current = new ArrayList<>();
+        for (List<CostingResult> group : groups) {
+            if (!current.isEmpty() && current.size() + group.size() > batchSize) {
+                batches.add(current);
+                current = new ArrayList<>();
+            }
+            current.addAll(group);
+        }
+        if (!current.isEmpty()) {
+            batches.add(current);
+        }
+        return batches;
+    }
 }
